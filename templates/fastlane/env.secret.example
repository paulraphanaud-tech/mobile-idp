# ⚠️  DO NOT COMMIT THIS FILE — copy to env.secret and fill in values
# These values are injected by AWS Secrets Manager in CI

# Fastlane Match (encrypts certs/profiles at rest in S3)
MATCH_PASSWORD=your-match-password

# Firebase
FIREBASE_CLI_TOKEN=your-firebase-cli-token

# App Store Connect API Key
APP_STORE_CONNECT_API_KEY_KEY_ID=your-key-id
APP_STORE_CONNECT_API_KEY_ISSUER_ID=your-issuer-id
APP_STORE_CONNECT_API_KEY_KEY=-----BEGIN EC PRIVATE KEY-----\nyour-key-content\n-----END EC PRIVATE KEY-----
APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64=false

# Android Keystore
KEYSTORE_PATH=keystore/release.keystore
KEYSTORE_PASSWORD=your-keystore-password
KEY_ALIAS=your-key-alias
KEY_PASSWORD=your-key-password
