FLAVOR=dev
SCHEME=dev

FIREBASE_APP_ANDROID={{FIREBASE_APP_ANDROID}}
FIREBASE_APP_IOS={{FIREBASE_APP_IOS}}

# Must be the Firebase App Distribution group's *alias* (a slug, e.g.
# "testers"), not its display name — `firebase appdistribution:group:create
# "Testers" testers` creates alias "testers". Passing the display name
# instead fails with "Invalid request" on the distribute step. The group
# itself must already exist; App Distribution won't create it on demand.
APP_STORE_TESTER_GROUP=testers

APP_IDENTIFIER={{IOS_BUNDLE_ID}}
APPLE_TEAM_ID={{APPLE_TEAM_ID}}
APPLE_USERNAME={{APPLE_USERNAME}}

AWS_PROFILE={{AWS_PROFILE}}
AWS_REGION={{AWS_REGION}}

MATCH_S3_BUCKET={{PROJECT_NAME}}-match
S3_KEYSTORE_BUCKET={{PROJECT_NAME}}-keystores
