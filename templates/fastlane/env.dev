FLAVOR=dev
SCHEME=dev

FIREBASE_APP_ANDROID={{FIREBASE_APP_ANDROID}}
FIREBASE_APP_IOS={{FIREBASE_APP_IOS}}

# Must be the Firebase App Distribution group's *alias* (a slug, e.g.
# "testers"), not its display name — `firebase appdistribution:group:create
# "Testers" testers` creates alias "testers". Passing the display name
# instead fails with "Invalid request" on the distribute step. The group
# itself must already exist; App Distribution won't create it on demand.
APP_STORE_TESTER_GROUP=testers

APP_IDENTIFIER={{IOS_BUNDLE_ID}}
APPLE_TEAM_ID={{APPLE_TEAM_ID}}
APPLE_USERNAME={{APPLE_USERNAME}}

AWS_PROFILE={{AWS_PROFILE}}
AWS_REGION={{AWS_REGION}}

# -----------------------------------------------------------------------------
# iOS signing — Fastlane Match storage
#
#   s3   certificates in the per-project bucket below (CI uses its IAM role)
#   git  certificates in a private git repo (MATCH_GIT_URL). CI then needs a
#        repo credential in Secrets Manager — see docs/secrets.md.
#
# In CI these come from Terraform (match_storage_mode, match_git_url,
# match_git_branch in the environment's tfvars); keep both in agreement.
# -----------------------------------------------------------------------------
MATCH_STORAGE_MODE={{MATCH_STORAGE_MODE}}
MATCH_S3_BUCKET={{PROJECT_NAME}}-match
MATCH_GIT_URL={{MATCH_GIT_URL}}
MATCH_GIT_BRANCH={{MATCH_GIT_BRANCH}}

S3_KEYSTORE_BUCKET={{PROJECT_NAME}}-keystores

# -----------------------------------------------------------------------------
# Feature flags
#
# FLAGS_URL is compiled into the app as a --dart-define (see dart_defines in
# modules/fastlane/common). It is a plain CloudFront URL, not a secret — a
# --dart-define is embedded in the binary in clear text and is recoverable from
# a downloaded APK, so nothing sensitive goes here.
#
# It does not exist until `make infra-apply` has created the distribution:
#
#     make infra-output ENV=dev | grep flags_document_url
#
# Leave it empty for the "firebase" or "none" backends. In CI all three of
# these come from Terraform as CodeBuild environment variables instead, so this
# file only matters for local builds.
# -----------------------------------------------------------------------------
FLAGS_BACKEND=none
FLAGS_URL=
