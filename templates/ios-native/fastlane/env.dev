# Non-secret configuration for native iOS builds (dev). Committed.
# Secrets are GitHub environment secrets (docs/github-distribution.md in
# mobile-idp) — or AWS Secrets Manager through OIDC when the GitHub
# environment has AWS_ROLE_ARN. Never put them here.

XCODE_PROJECT={{XCODE_PROJECT}}
XCODE_WORKSPACE={{XCODE_WORKSPACE}}
SCHEME={{SCHEME}}
APP_TARGET={{SCHEME}}
CONFIGURATION=Release
EXPORT_METHOD=app-store

APP_IDENTIFIER={{IOS_BUNDLE_ID}}
APPLE_TEAM_ID={{APPLE_TEAM_ID}}

# Internal TestFlight group(s), comma-separated. Empty = no group assignment
# (internal testers still get every build automatically).
APP_STORE_TESTER_GROUP=

# Firebase App Distribution (ad-hoc builds). App ID from Firebase console →
# Project settings → your iOS app. Groups are *aliases*, comma-separated.
FIREBASE_APP_IOS={{FIREBASE_APP_IOS}}
FIREBASE_TESTER_GROUPS={{FIREBASE_TESTER_GROUPS}}

# Match storage. The GitHub workflows use the private SIGNING_REPO (git) and
# override these; they matter only for AWS-mode CI and local runs.

AWS_REGION={{AWS_REGION}}
MATCH_S3_BUCKET={{PROJECT_NAME}}-match
