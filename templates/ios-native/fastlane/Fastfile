fastlane_require 'dotenv'

# =============================================================================
# {{PROJECT_NAME}} — native iOS (Xcode) lanes, generated by IDP bootstrap-ios-native
#
# The IDP modules are not vendored: CI checks out mobile-idp at {{IDP_REF}}
# into {{MODULES_ROOT}}/ (see .github/workflows/*). Locally, `make idp-fetch`
# does the same.
# =============================================================================
before_all do
  env_name = ENV['FASTLANE_ENV'] || 'dev'
  env_file = "env.#{env_name}"
  secret_file = 'env.secret'

  if File.exist?(env_file)
    Dotenv.overload env_file
    UI.message("Env loaded from #{env_file}!")
  end

  if File.exist?(secret_file)
    Dotenv.overload secret_file
    UI.message("Secrets loaded from #{secret_file}!")
  elsif ENV['CI'] || ENV['CODEBUILD_BUILD_ID']
    UI.message("CI detected: secrets come from the environment.")
  end

  # A temporary keychain for match on CI runners (GitHub Actions sets CI).
  setup_ci if ENV['CI'] && !ENV['CODEBUILD_BUILD_ID']

  if ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'].to_s != ''
    app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY'],
      is_key_content_base64: ENV['APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64'] == 'true',
      in_house: false
    )
  end
end

default_platform(:ios)

import "../{{MODULES_PATH}}/fastlane/common/Fastfile"
import "../{{MODULES_PATH}}/fastlane/match_s3/Fastfile"
import "../{{MODULES_PATH}}/fastlane/produce/Fastfile"
import "../{{MODULES_PATH}}/fastlane/ios_native/Fastfile"

platform :ios do
  # Simulator tests — no signing, no secrets.
  lane :test do
    test_ios_native
  end

  # Unsigned simulator .app, zipped (for Appetize browser previews).
  lane :build_simulator do
    build_ios_native_simulator
  end

  # Signed IPA, not uploaded.
  lane :build do |options|
    build_ios_native(options[:version], options[:bump], nil, nil)
  end

  lane :deploy_testflight do |options|
    deploy_ios_native_to_testflight(options[:version], options[:bump])
  end

  lane :sync_certs do |options|
    sync_certificates(options[:type], options[:readonly])
  end

  # GATED in the Makefile — App Store Connect records cannot be deleted.
  lane :create_app do |options|
    create_app_on_asc(options[:name], options[:language])
  end
end
