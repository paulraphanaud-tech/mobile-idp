# =============================================================================
# {{PROJECT_NAME}} — native iOS, generated by IDP bootstrap-ios-native
#
# Most people never run these locally: CI runs them on GitHub-hosted macOS
# runners (.github/workflows). They exist so a Mac user gets the same lanes.
# =============================================================================

ENV ?= dev
BUMP ?= patch
IDP_REPO ?= https://github.com/{{IDP_REPO}}.git
IDP_REF ?= {{IDP_REF}}
FASTLANE = FASTLANE_ENV=$(ENV) bundle exec fastlane

.PHONY: idp-fetch install test build-simulator build-ios deploy-ios-testflight sync-certs sync-certs-appstore create-app help

idp-fetch: ## Fetch the IDP modules into {{MODULES_ROOT}}/ (same ref CI uses)
	@if [ -d {{MODULES_ROOT}}/.git ]; then git -C {{MODULES_ROOT}} fetch --depth 1 origin $(IDP_REF) && git -C {{MODULES_ROOT}} checkout -q FETCH_HEAD; \
	else git clone --depth 1 --branch $(IDP_REF) $(IDP_REPO) {{MODULES_ROOT}}; fi

install: idp-fetch ## Install Ruby gems
	bundle install

test: ## Simulator tests (no signing) — Tier 1
	$(FASTLANE) ios test

build-simulator: ## Unsigned simulator .app zip — Tier 1
	$(FASTLANE) ios build_simulator

build-ios: ## Signed IPA, not uploaded — Tier 1
	$(FASTLANE) ios build bump:$(BUMP)

deploy-ios-testflight: ## Upload to TestFlight — Tier 2 (build number consumed forever)
	$(FASTLANE) ios deploy_testflight bump:$(BUMP)

sync-certs: ## Match development certs, read-only
	$(FASTLANE) ios sync_certs type:development readonly:true

sync-certs-appstore: ## Match App Store certs, read-only
	$(FASTLANE) ios sync_certs type:appstore readonly:true

create-app: ## GATED — App Store Connect records cannot be deleted
	@bash {{MODULES_ROOT}}/scripts/confirm.sh "create {{IOS_BUNDLE_ID}}" \
		"Creates the App Store Connect record for {{IOS_BUNDLE_ID}}." \
		"App records cannot be deleted and app names are globally unique."
	$(FASTLANE) ios create_app name:"$(APP_NAME)"

help:
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-24s %s\n", $$1, $$2}'
