# ⚠️  DO NOT COMMIT — copy to env.secret for *local* runs only.
# CI reads these from GitHub environment secrets (docs/github-distribution.md).

MATCH_PASSWORD=your-match-password
IDP_MATCH_STORAGE_MODE=git
IDP_MATCH_GIT_URL=https://github.com/OWNER/signing.git

APP_STORE_CONNECT_API_KEY_KEY_ID=your-key-id
APP_STORE_CONNECT_API_KEY_ISSUER_ID=your-issuer-id
APP_STORE_CONNECT_API_KEY_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-content\n-----END PRIVATE KEY-----"

FIREBASE_SERVICE_CREDENTIALS_FILE=/path/to/service-account.json
