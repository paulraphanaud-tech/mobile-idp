# Non-secret configuration for test builds (dev). Committed.
# Secrets are GitHub environment secrets — see docs/github-distribution.md in
# mobile-idp. Never put them here. Copy this file to env.staging / env.prod
# for other environments.

# Empty = no flavors (a plain `flutter create` app). Set both when the app
# defines flavors.
FLAVOR=
SCHEME=

# iOS bundle ID. Set on the Release configuration at build time, so the
# com.example.* placeholder of a generated ios/ folder never ships.
APP_IDENTIFIER={{IOS_BUNDLE_ID}}
# developer.apple.com → Membership details → Team ID
APPLE_TEAM_ID={{APPLE_TEAM_ID}}

# Firebase console → Project settings → Your apps → App ID.
# The Android app's package name must be the app's applicationId:
# {{ANDROID_PACKAGE_HINT}}
FIREBASE_APP_ANDROID={{FIREBASE_APP_ANDROID}}
FIREBASE_APP_IOS={{FIREBASE_APP_IOS}}
# App Distribution group *aliases*, comma-separated (the group must exist).
FIREBASE_TESTER_GROUPS={{FIREBASE_TESTER_GROUPS}}

# TestFlight: internal testers only — installable minutes after processing,
# no Beta App Review. Group names are optional; internal testers get every
# build anyway.
APP_STORE_TESTER_GROUP=
TESTFLIGHT_DISTRIBUTE_EXTERNAL=false
# Export compliance. "false" = the app only uses HTTPS / the OS's own crypto
# (exempt). If it ships its own encryption, set "true" and answer the
# compliance questions in App Store Connect.
USES_NON_EXEMPT_ENCRYPTION=false
