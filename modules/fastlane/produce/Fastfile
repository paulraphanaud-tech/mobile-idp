# =============================================================================
# Module: Produce
# Provides: create_app_on_asc(name, language)
#
# Auth: this lane does NOT use the App Store Connect API key. Apple's public
# API has no app-creation endpoint — hitting it with an API-key JWT returns
# "The resource 'apps' does not allow 'CREATE'. Allowed operations are:
# GET_COLLECTION, GET_INSTANCE, UPDATE". `produce` instead drives the same
# internal endpoint the App Store Connect website uses, authenticated with a
# web session, which *does* permit creation.
#
# That session can be supplied non-interactively via env vars, so this lane
# runs headlessly (locally and in CI):
#
#   FASTLANE_USER     — Apple ID (same value as APPLE_USERNAME)
#   FASTLANE_PASSWORD — Apple ID password
#   FASTLANE_SESSION  — 2FA session cookie
#
# Generate FASTLANE_SESSION once with:
#   bundle exec fastlane spaceauth -u <apple-id>
# It prompts for the 2FA code on your device, then prints a YAML cookie
# string to export. It is valid for roughly 30 days, after which the lane
# fails with UnauthorizedAccessError and you re-run spaceauth. Store all
# three in fastlane/env.secret locally and in Secrets Manager for CI.
#
# skip_devcenter is set below: Bundle ID registration on the Developer
# Portal is a separate one-time step with no automatable equivalent, so
# register the identifier at
# developer.apple.com/account/resources/identifiers first, then this lane
# creates only the App Store Connect record.
# =============================================================================

def create_app_on_asc(name, language)
  app_identifier = ENV['APP_IDENTIFIER']
  app_name = name || ENV['APP_NAME']
  team_id = ENV['APPLE_TEAM_ID']

  # Authenticated by FASTLANE_USER/PASSWORD/SESSION, not the ASC API key
  # established in before_all — see module note above.

  produce(
    username: ENV['APPLE_USERNAME'],
    app_identifier: app_identifier,
    app_name: app_name,
    team_id: team_id,
    sku: ENV['APP_SKU'] || app_identifier,
    language: language || "en-US",
    enable_services: {},
    skip_devcenter: true
  )

  UI.message("App '#{app_name}' (#{app_identifier}) created on App Store Connect!")
end
