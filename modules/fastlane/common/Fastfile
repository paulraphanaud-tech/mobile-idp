# =============================================================================
# Module: Common
# Shared helpers for all Fastlane modules
# =============================================================================

require 'shellwords'

# Walks up from the working directory to the folder holding pubspec.yaml.
# fastlane's working directory is not consistent: real actions (gym, etc.) run
# from the project root, but a bare `sh` runs from fastlane/, so a single
# relative path cannot work for both. Searching from Dir.pwd also works
# whatever the modules' location: a path relative to this file (as before)
# reached the project root only when modules/ was copied in, and ci-cd/ when
# it is a git submodule at ci-cd/.
def flutter_project_root
  dir = Dir.pwd
  until dir == "/"
    return dir if File.exist?(File.join(dir, "pubspec.yaml"))
    dir = File.dirname(dir)
  end
  UI.user_error!("Could not find the Flutter project root (no pubspec.yaml at or above #{Dir.pwd})")
end

def in_project_root(&block)
  Dir.chdir(flutter_project_root, &block)
end

def prepare_and_check
  in_project_root do
    sh("flutter clean")
    sh("flutter pub get")

    UI.message("Preparation step done with success!")
  end
end

def compute_next_version(version, bump, latest_build_number, latest_version)
  default_version = "1.0.0"
  build_number = (latest_build_number || 0).to_i + 1

  if version
    UI.success("Next build will be #{version}+#{build_number}")
    return version, build_number
  end

  base_version = latest_version || default_version

  unless base_version =~ /^\d+\.\d+\.\d+$/
    UI.important("'#{base_version}' is not valid. Using default value: #{default_version}")
    base_version = default_version
  end

  major, minor, patch = base_version.split('.').map(&:to_i)
  bump = (bump || "patch").downcase

  case bump
  when "major"
    major += 1
    minor = 0
    patch = 0
  when "minor"
    minor += 1
    patch = 0
  else
    patch += 1
  end

  build_version = "#{major}.#{minor}.#{patch}"
  UI.success("Next build will be #{build_version}+#{build_number}")

  return build_version, build_number
end

# =============================================================================
# Dart defines
#
# Compile-time configuration the app reads with String.fromEnvironment. Used for
# values that must be fixed in the binary rather than fetched — the feature flag
# document URL is the main one, because the app needs it before it can fetch
# anything.
#
# Only non-secret identifiers belong here. A --dart-define is embedded in the
# binary in plain text and is trivially recoverable from a downloaded APK or
# IPA, so it is configuration, not a secret. Credentials stay in Secrets
# Manager and never reach a build command.
# =============================================================================

# Environment variables forwarded into the build as --dart-define, mapped to
# the name the app reads. Unset variables are skipped rather than passed empty,
# so String.fromEnvironment's defaultValue applies.
DART_DEFINE_VARS = {
  'FLAGS_URL' => 'FLAGS_URL',
  'FLAGS_BACKEND' => 'FLAGS_BACKEND',
  'ENVIRONMENT' => 'ENVIRONMENT',
  'APP_ENV' => 'APP_ENV'
}.freeze

def dart_defines
  extra = (ENV['EXTRA_DART_DEFINES'] || '').split(',').map(&:strip).reject(&:empty?)

  defines = DART_DEFINE_VARS.filter_map do |env_name, define_name|
    value = ENV[env_name]
    next if value.nil? || value.empty?

    "--dart-define=#{define_name}=#{Shellwords.escape(value)}"
  end

  # EXTRA_DART_DEFINES carries already-formed KEY=VALUE pairs for anything the
  # map above does not cover, so a project can add its own without editing the
  # IDP module.
  defines += extra.map { |pair| "--dart-define=#{Shellwords.escape(pair)}" }

  return '' if defines.empty?

  UI.message("Dart defines: #{defines.map { |d| d.split('=').first(2).join('=') }.join(' ')}")
  " #{defines.join(' ')}"
end
