# =============================================================================
# Module: iOS Build
# Provides: update_ios_version, build_ios(version, bump, latest_build_number, latest_version),
#           ios_ipa_path
# Requires: common module (prepare_and_check, compute_next_version)
#
# Flavors are optional. With FLAVOR set, the build uses --flavor <flavor>, the
# Release-<flavor> configuration, scheme SCHEME (or the flavor name) and
# ios/export_options_<flavor>.plist. With FLAVOR unset or empty — a project
# with no environments yet — it uses the plain Release configuration, scheme
# SCHEME (or Runner) and ios/export_options.plist.
# =============================================================================

def ios_flavor
  flavor = ENV['FLAVOR'].to_s.strip
  flavor.empty? ? nil : flavor
end

# Where gym writes the IPA, and where the deploy modules read it from.
def ios_ipa_path
  name = ios_flavor ? "app-#{ios_flavor}-release.ipa" : "app-release.ipa"
  "build/ios/ipa/#{name}"
end

def update_ios_version(version, bump, latest_build_number, latest_version)
  build_version, build_number = compute_next_version(version, bump, latest_build_number, latest_version)

  increment_build_number(
    build_number: "#{build_number}",
    xcodeproj: "./ios/Runner.xcodeproj",
  )

  increment_version_number(
    version_number: build_version,
    xcodeproj: "./ios/Runner.xcodeproj",
  )

  UI.message("Version updated => #{build_version}(#{build_number})!")
end

require 'shellwords'

# Maps an export_options.plist `method` to the Match profile-type name that
# appears in the profile Match creates ("match <Type> <bundle id>").
MATCH_TYPE_FOR_EXPORT_METHOD = {
  "app-store"   => "AppStore",
  "ad-hoc"      => "AdHoc",
  "development" => "Development",
  "enterprise"  => "InHouse",
}.freeze

# The signing identity each export method's profile expects. An App Store or
# ad-hoc profile only accepts a distribution certificate, so leaving Xcode to
# pick the development one fails with "Provisioning profile ... doesn't
# include signing certificate 'Apple Development: ...'".
CODE_SIGN_IDENTITY_FOR_EXPORT_METHOD = {
  "app-store"   => "Apple Distribution",
  "ad-hoc"      => "Apple Distribution",
  "enterprise"  => "Apple Distribution",
  "development" => "Apple Development",
}.freeze

# flutter_project_root comes from the common module.

def build_ios(version, bump, latest_build_number, latest_version)
  flavor = ios_flavor
  scheme = ENV['SCHEME'].to_s.strip
  scheme = flavor || "Runner" if scheme.empty?
  configuration = flavor ? "Release-#{flavor}" : "Release"
  app_identifier = ENV['APP_IDENTIFIER']
  team_id = ENV['APPLE_TEAM_ID']

  prepare_and_check
  update_ios_version(version, bump, latest_build_number, latest_version)

  flavor_arg = flavor ? " --flavor #{flavor}" : ""
  # A bare `sh` runs from fastlane/, where flutter finds no pubspec.yaml.
  in_project_root do
    sh("flutter build ios --release#{flavor_arg} --no-codesign#{dart_defines}")
  end

  # Take the export method from the flavor's own plist rather than assuming
  # app-store — dev/staging flavors export ad-hoc for Firebase distribution.
  # Absolute path so it resolves the same from any fastlane working directory.
  plist_name = flavor ? "export_options_#{flavor}.plist" : "export_options.plist"
  export_options = File.join(flutter_project_root, "ios", plist_name)
  UI.user_error!("Missing export options plist: #{export_options}") unless File.exist?(export_options)

  export_method = sh(
    "/usr/libexec/PlistBuddy -c 'Print :method' #{export_options.shellescape}",
    log: false
  ).strip

  match_type = MATCH_TYPE_FOR_EXPORT_METHOD[export_method]
  UI.user_error!("Unsupported export method '#{export_method}' in #{export_options}") if match_type.nil?
  profile_name = "match #{match_type} #{app_identifier}"

  # Scope manual signing to the Runner target's own configuration. Passing
  # these through gym's xcargs instead would apply them to every target in
  # the workspace, including Flutter plugin Swift packages, which fail with
  # "<target> does not support provisioning profiles".
  update_code_signing_settings(
    path: "./ios/Runner.xcodeproj",
    use_automatic_signing: false,
    targets: ["Runner"],
    build_configurations: [configuration],
    team_id: team_id,
    code_sign_identity: CODE_SIGN_IDENTITY_FOR_EXPORT_METHOD[export_method],
    profile_name: profile_name,
    bundle_identifier: app_identifier,
  )

  gym(
    workspace: "./ios/Runner.xcworkspace",
    # With flavors this must be the flavor's own build configuration. The base
    # "Release" config keeps Flutter's placeholder PRODUCT_BUNDLE_IDENTIFIER
    # (com.example.*), so archiving with it silently produces an IPA with the
    # wrong bundle ID. Without flavors, "Release" is the only configuration,
    # and update_code_signing_settings above has just set its bundle ID.
    configuration: configuration,
    scheme: scheme,
    export_method: export_method,
    export_options: export_options,
    output_name: File.basename(ios_ipa_path),
    output_directory: "./build/ios/ipa",
  )

  UI.message("Successfully built IPA!")
end
